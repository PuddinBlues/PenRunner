{
  "name": "penrunner",
  "private": true,
  "version": "0.1.0",
  "description": "Gestionale per gare di reining (IRHA/FISE)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "db:generate": "pnpm --filter @penrunner/db generate",
    "db:migrate": "pnpm --filter @penrunner/db migrate",
    "db:seed": "pnpm --filter @penrunner/db seed",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "wrangler": "^4.114.0"
  }
}
